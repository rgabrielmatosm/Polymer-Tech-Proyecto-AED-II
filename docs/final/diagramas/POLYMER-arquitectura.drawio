th="840" height="860" as="geometry"/></mxCell><mxCell id="p1_coreT" value="NÚCLEO  (application + domain)  ·  Java puro, sin frameworks" style="whiteSpace=wrap;html=0;fontSize=15;fontColor=#0F172A;align=center;verticalAlign=middle;fontStyle=1;text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="580" height="30" as="geometry"/></mxCell><mxCell id="p1_uc" value="CASOS DE USO  (application/service · 17)&#xa;CommerceService · PaymentService · SignInService · CatalogService&#xa;CartService · OperationsService · LogisticsService · TestimonialService&#xa;NotificationService · EventRelayService · StoreService · …" style="whiteSpace=wrap;html=0;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#EEF2FF;strokeColor=#4F46E5;spacing=6;" vertex="1" parent="1"><mxGeometry x="560" y="196" width="580" height="112" as="geometry"/></mxCell><mxCell id="p1_pin" value="PUERTOS DE ENTRADA&#xa;(application/port/in · 17)&#xa;&#xa;CommerceUseCases&#xa;PaymentUseCases&#xa;SignInUseCases&#xa;CatalogUseCases&#xa;CartUseCases&#xa;OperationsUseCases&#xa;LogisticsUseCases&#xa;TestimonialUseCases&#xa;NotificationUseCases&#xa;…" style="whiteSpace=wrap;html=0;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4F46E5;spacing=6;" vertex="1" parent="1"><mxGeometry x="500" y="340" width="190" height="400" as="geometry"/></mxCell><mxCell id="p1_dom" value="DOMINIO  (domain/)&#xa;&#xa;Order · OrderStatus (≥70 → revisión)&#xa;TransitionPolicy (grafo de estados)&#xa;CommerceOrder · CheckoutSummary&#xa;PaymentPolicy (TTL Yape 60 s, IGV 18 %)&#xa;CardDetails (Luhn) · Receipt&#xa;Delivery (choque de intervalos)&#xa;CatalogSearch · PriceTag · Category&#xa;VerificationPolicy (6 dígitos, 10 min)&#xa;BusinessHours · PeruHolidays (Pascua)&#xa;Testimonial · BusinessEvent" style="whiteSpace=wrap;html=0;fontSize=11;fontColor=#0F172A;align=center;verticalAlign=middle;shap