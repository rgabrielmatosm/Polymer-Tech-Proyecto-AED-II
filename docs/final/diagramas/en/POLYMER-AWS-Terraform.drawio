<mxfile host="app.diagrams.net" agent="POLYMER tools/diagramas/generate_aws_diagram.py"><diagram id="polymer-aws-1" name="1 · AWS · POLYMER deployed (Terraform)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2640" pageHeight="1720" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a_title" value="&lt;b style=&quot;font-size:26px&quot;&gt;POLYMER on Amazon Web Services&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;One EC2 instance running Docker Compose (13 containers) behind Caddy (HTTPS), created with Terraform · &lt;b&gt;https://18-189-49-9.sslip.io&lt;/b&gt;&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1900" height="70" as="geometry"/></mxCell><mxCell id="a_laptop" value="Administrator laptop (Windows)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#F8FAFC;strokeColor=#475569;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="340" height="690" as="geometry"/></mxCell><mxCell id="a_client" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;fillColor=#232F3D;shape=mxgraph.aws4.client;" vertex="1" parent="a_laptop"><mxGeometry x="131" y="38" width="78" height="76" as="geometry"/></mxCell><mxCell id="a_tf" value="&lt;b&gt;Terraform CLI&lt;/b&gt;&lt;br&gt;terraform init · plan · apply · destroy&lt;br&gt;local &lt;i&gt;terraform.tfstate&lt;/i&gt; (private)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7ED